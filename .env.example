# Copy to .env and fill real values. chmod 600 .env
#   cp .env.example .env
#   openssl rand -hex 32  → SESSION_SECRET

DOCKER_STEPCA_INIT_PASSWORD=change-me-ca-password
PROVISIONER_PASSWORD=change-me-ca-password
SESSION_SECRET=change-me-session-secret
CA_NAME=SSH CA
CA_DNS_NAMES=step-ca,localhost,127.0.0.1

# Reuse an existing PKI volume when migrating from ssh-ca-lab:
# PKI_VOLUME=ssh-ca-lab_step-ca-data
# REDIS_VOLUME=ssh-ca-lab_redis-data

CERT_TTL=8h
ALLOW_LOCAL_LOGIN=false
SESSION_HTTPS_ONLY=false

PORTAL_PUBLIC_URL=http://127.0.0.1:8088
SSH_HINT_HOST=127.0.0.1
SSH_HINT_PORT=22

# Optional emergency local portal accounts (also enabled by docker-compose.demo.yml).
# PORTAL_USER=
# PORTAL_PASSWORD=

# sudo password for the sre Unix account on demo/target hosts only.
SRE_PASSWORD=change-me-sre-unix-password

# Feishu. Redirect URL must match the app console exactly.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URL=http://127.0.0.1:8088/auth/feishu/callback
FEISHU_AUTH_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_TOKEN_URL=https://accounts.feishu.cn/oauth/v3/token
FEISHU_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
FEISHU_SCOPES=contact:user.email:readonly contact:user.employee_id:readonly contact:contact.base:readonly
