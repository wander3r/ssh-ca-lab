# Copy to .env and change passwords before compose up.
#   cp .env.example .env
DOCKER_STEPCA_INIT_PASSWORD=change-me-ca-password
PROVISIONER_PASSWORD=change-me-ca-password
PORTAL_USER=demo
PORTAL_PASSWORD=demo
# Unix password for sre on ssh-target (sudo). SSH still uses certificates only.
SRE_PASSWORD=sre
SESSION_SECRET=change-me-session-secret
ALLOW_LOCAL_LOGIN=true
SESSION_HTTPS_ONLY=false

# Public URL the browser and CLI helper use (must match how you open the portal).
# HTTP :8088 through the Nginx proxy, or HTTPS :8443 (self-signed).
PORTAL_PUBLIC_URL=http://127.0.0.1:8088
SSH_HINT_HOST=127.0.0.1
SSH_HINT_PORT=2222

# Optional Feishu OAuth. Leave empty to hide the button.
# Redirect URL must be registered on the Feishu app exactly.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URL=http://127.0.0.1:8088/auth/feishu/callback
FEISHU_AUTH_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_TOKEN_URL=https://accounts.feishu.cn/oauth/v3/token
FEISHU_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
# User OAuth scopes. Department names still come from tenant token +
# contact:user.department:readonly on the Feishu app (not this line).
FEISHU_SCOPES=contact:user.email:readonly contact:user.employee_id:readonly contact:contact.base:readonly
